            "text": "{\"data\":{\"node\":{\"__typename\":\"ActionDetails\",\"nodeId\":\"QWN0aW9uRGV0YWlsczpCcm93c2VyLnNlYXJjaC5udWxs\",\"inputSchema\":{\"type\":\"object\",\"required\":[\"query\"],\"properties\":{\"query\":{\"type\":\"string\",\"description\":\"The search query.\"},\"engineOptions\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"engine\":{\"type\":\"string\",\"const\":\"bing\"},\"location\":{\"type\":\"string\",\"description\":\"e.g San Francisco, CA\"}},\"required\":[\"engine\"],\"additionalProperties\":false,\"lindyMetadata\":{\"displayName\":\"Bing\"}},{\"type\":\"object\",\"properties\":{\"engine\":{\"type\":\"string\",\"const\":\"events\"},\"location\":{\"type\":\"string\",\"description\":\"e.g San Francisco, CA\"}},\"required\":[\"engine\"],\"additionalProperties\":false,\"lindyMetadata\":{\"displayName\":\"Events\"}},{\"type\":\"object\",\"properties\":{\"engine\":{\"type\":\"string\",\"const\":\"images\"},\"location\":{\"type\":\"string\",\"description\":\"e.g San Francisco, CA\"}},\"required\":[\"engine\"],\"additionalProperties\":false,\"lindyMetadata\":{\"displayName\":\"Images\"}},{\"type\":\"object\",\"properties\":{\"engine\":{\"type\":\"string\",\"const\":\"jobs\"},\"location\":{\"type\":\"string\",\"description\":\"e.g San Francisco, CA\"}},\"required\":[\"engine\"],\"additionalProperties\":false,\"lindyMetadata\":{\"displayName\":\"Jobs\"}},{\"type\":\"object\",\"properties\":{\"engine\":{\"type\":\"string\",\"const\":\"news\"},\"gl\":{\"type\":\"string\",\"description\":\"Parameter defines the country to use for the Google News search. It's a two-letter country code. (e.g., us for the United States (default), uk for United Kingdom, or fr for France). Head to the [Google countries page](https://serpapi.com/google-countries) for a full list of supported Google News countries.\"},\"location\":{\"type\":\"string\",\"description\":\"e.g San Francisco, CA\"}},\"required\":[\"engine\"],\"additionalProperties\":false,\"lindyMetadata\":{\"displayName\":\"News\"}},{\"type\":\"object\",\"properties\":{\"engine\":{\"type\":\"string\",\"const\":\"shopping\"},\"location\":{\"type\":\"string\",\"description\":\"e.g San Francisco, CA\"}},\"required\":[\"engine\"],\"additionalProperties\":false,\"lindyMetadata\":{\"displayName\":\"Shopping\"}},{\"type\":\"object\",\"properties\":{\"engine\":{\"type\":\"string\",\"const\":\"yelp\"},\"location\":{\"type\":\"string\",\"description\":\"e.g San Francisco, CA\"}},\"required\":[\"engine\"],\"additionalProperties\":false,\"lindyMetadata\":{\"displayName\":\"Yelp\"}},{\"type\":\"object\",\"properties\":{\"engine\":{\"type\":\"string\",\"const\":\"duckduckgo\"},\"kl\":{\"type\":\"string\",\"description\":\"e.g. us-en\"}},\"required\":[\"engine\"],\"additionalProperties\":false,\"lindyMetadata\":{\"displayName\":\"DuckDuckGo\"}},{\"type\":\"object\",\"properties\":{\"engine\":{\"type\":\"string\",\"const\":\"ebay\"},\"ebay_domain\":{\"type\":\"string\",\"description\":\"e.g. ebay.com\"}},\"required\":[\"engine\"],\"additionalProperties\":false,\"lindyMetadata\":{\"displayName\":\"eBay\"}},{\"type\":\"object\",\"properties\":{\"engine\":{\"type\":\"string\",\"const\":\"hotels\"},\"check_in_date\":{\"type\":\"string\",\"description\":\"YYYY-MM-DD\"},\"check_out_date\":{\"type\":\"string\",\"description\":\"YYYY-MM-DD\"},\"adults\":{\"type\":\"number\"},\"currency\":{\"type\":\"string\",\"description\":\"e.g. USD, EUR, GBP\"}},\"required\":[\"engine\",\"check_in_date\",\"check_out_date\"],\"additionalProperties\":false,\"lindyMetadata\":{\"displayName\":\"Hotels\"}},{\"type\":\"object\",\"properties\":{\"engine\":{\"type\":\"string\",\"const\":\"flights\"},\"departure_id\":{\"type\":\"string\",\"description\":\"e.g. SFO\"},\"arrival_id\":{\"type\":\"string\",\"description\":\"e.g. LHR\"},\"outbound_date\":{\"type\":\"string\",\"description\":\"YYYY-MM-DD\"},\"return_date\":{\"type\":\"string\",\"description\":\"YYYY-MM-DD\"},\"currency\":{\"type\":\"string\"}},\"required\":[\"engine\",\"departure_id\",\"arrival_id\",\"outbound_date\"],\"additionalProperties\":false,\"lindyMetadata\":{\"displayName\":\"Flights\"}},{\"type\":\"object\",\"properties\":{\"engine\":{\"type\":\"string\",\"const\":\"maps\"},\"ll\":{\"type\":\"string\",\"description\":\"e.g. @37.7676316,-122.4183248,18z\"}},\"required\":[\"engine\",\"ll\"],\"additionalProperties\":false,\"lindyMetadata\":{\"displayName\":\"Maps\"}},{\"type\":\"object\",\"properties\":{\"engine\":{\"type\":\"string\",\"const\":\"youtube\"},\"resultType\":{\"type\":\"string\",\"enum\":[\"video\",\"channel\",\"playlist\"]}},\"required\":[\"engine\"],\"additionalProperties\":false,\"lindyMetadata\":{\"displayName\":\"YouTube\"}},{\"type\":\"object\",\"properties\":{\"engine\":{\"type\":\"string\",\"const\":\"google\"},\"location\":{\"type\":\"string\",\"description\":\"e.g San Francisco, CA\"}},\"required\":[\"engine\"],\"additionalProperties\":false,\"lindyMetadata\":{\"displayName\":\"Google\"}}],\"default\":{\"engine\":\"google\"},\"description\":\"Choose the engine most relevant to the query.\\nE.g. Whenever the user asks for news on a specific topic, use the news engine to search for the latest articles.\\nIf they are searching for products to buy, use the shopping engine. If you're not sure, use google.\",\"lindyMetadata\":{\"displayName\":\"Search engine\",\"userDescription\":\"The search engine to use for the query.\"}}},\"additionalProperties\":false},\"inputTree\":null}}}"
