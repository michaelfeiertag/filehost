            "mimeType": "application/json",
            "text": "{\"query\":\"query TasksLayoutQuery(\\n  $nodeId: ID!\\n  $workspaceUrl: String!\\n  $shouldShowAllWizardTasks: Boolean\\n) {\\n  me {\\n    ...CommonLayoutSidebar_Identity_2hyKer\\n    ...CommonLayout_Identity_2hyKer\\n    nodeId\\n  }\\n  ...TasksContentSection_Query_4c4oCW\\n}\\n\\nfragment ActionCardFormBuilder_AgentDefinition_1lASWf on AgentDefinition {\\n  ...FormBuilder_AgentDefinition_1lASWf\\n}\\n\\nfragment ActionCardFormBuilder_Identity_2hyKer on Identity {\\n  ...FormBuilder_Identity_2hyKer\\n}\\n\\nfragment ActionCardMemoryForm_AgentDefinition on AgentDefinition {\\n  icon {\\n    name\\n    color\\n  }\\n}\\n\\nfragment ActionCardTestAgent_AgentDefinition on AgentDefinition {\\n  id\\n}\\n\\nfragment AdminCreditsFooter_Identity_2hyKer on Identity {\\n  ...PlansModal_Identity_2hyKer\\n}\\n\\nfragment AdminCreditsFooter_SubscriptionInfo on SubscriptionInfo {\\n  creditsResetDate\\n  creditsInfo {\\n    percentConsumed\\n    ...CreditUsage_CreditsInfo\\n    nodeId\\n  }\\n  trialInfo {\\n    expiresAt\\n    ...CreditUsage_TrialInfo\\n    nodeId\\n  }\\n}\\n\\nfragment AgentBuilderInputSection_Identity_2hyKer on Identity {\\n  agentBuilderAgentDefinition {\\n    ...AgentBuilderTaskInput_AgentDefinition\\n    ...useTaskInput_AgentDefinition\\n    nodeId\\n  }\\n  ...useAgentBuilderAgentIds_Identity\\n  ...AgentBuilderTaskInput_Identity_2hyKer\\n  ...PromptStarterSection_Identity\\n}\\n\\nfragment AgentBuilderTaskInput_AgentDefinition on AgentDefinition {\\n  ...SpeechToTextControl_AgentDefinition\\n}\\n\\nfragment AgentBuilderTaskInput_Identity_2hyKer on Identity {\\n  flags {\\n    isLindyAssistant\\n  }\\n  ...AppBuilderToggleButton_Identity\\n  ...SpeechToTextControl_Identity_2hyKer\\n}\\n\\nfragment AgentContextMenuAgentDefinitionFragment on AgentDefinition {\\n  id\\n  name\\n  isMuted\\n  isFavorite\\n  notificationsCount\\n  permission\\n  ...UpdateAgentDefinitionIsFavoriteMutation_AgentDefinition\\n  ...MoveToWorkspaceContextMen