            "mimeType": "application/json",
            "text": "{\"query\":\"query MyLindiesContentSectionPrefetchQuery(\\n  $workspaceUrl: String!\\n) {\\n  me {\\n    ...MyLindiesContentSection_Identity_2hyKer\\n    nodeId\\n  }\\n}\\n\\nfragment AgentBuilderInputSection_Identity_2hyKer on Identity {\\n  agentBuilderAgentDefinition {\\n    ...AgentBuilderTaskInput_AgentDefinition\\n    ...useTaskInput_AgentDefinition\\n    nodeId\\n  }\\n  ...useAgentBuilderAgentIds_Identity\\n  ...AgentBuilderTaskInput_Identity_2hyKer\\n  ...PromptStarterSection_Identity\\n}\\n\\nfragment AgentBuilderTaskInput_AgentDefinition on AgentDefinition {\\n  ...SpeechToTextControl_AgentDefinition\\n}\\n\\nfragment AgentBuilderTaskInput_Identity_2hyKer on Identity {\\n  flags {\\n    isLindyAssistant\\n  }\\n  ...AppBuilderToggleButton_Identity\\n  ...SpeechToTextControl_Identity_2hyKer\\n}\\n\\nfragment AgentContextMenuAgentDefinitionFragment on AgentDefinition {\\n  id\\n  name\\n  isMuted\\n  isFavorite\\n  notificationsCount\\n  permission\\n  ...UpdateAgentDefinitionIsFavoriteMutation_AgentDefinition\\n  ...MoveToWorkspaceContextMenuItem_AgentDefinition\\n  ...MoveToFolderContextMenuItem_AgentDefinition\\n  ...ShareAgentModalV2_AgentDefinition\\n}\\n\\nfragment AgentContextMenuIdentityFragment_2hyKer on Identity {\\n  id\\n  ...DeleteAgentDefinitionMutationFragment_2hyKer\\n  ...CopyAgentDefinitionMutationIdentityFragment_2hyKer\\n  ...UpdateAgentDefinitionIsFavoriteMutation_Identity\\n  ...MoveToWorkspaceContextMenuItem_Identity_2hyKer\\n  ...MoveAgentDefinitionsToWorkspaceMutation_Identity_2hyKer\\n  ...MoveToFolderContextMenuItem_Identity_2hyKer\\n  ...ShareAgentModalV2_Identity_2hyKer\\n}\\n\\nfragment AgentRowAgentDefinitionFragment on AgentDefinition {\\n  id\\n  name\\n  enabled\\n  icon {\\n    name\\n    color\\n  }\\n  lastRunAt\\n  isFavorite\\n  uniqueTools {\\n    tool\\n    displayName\\n    nodeId\\n  }\\n  ownerInfo {\\n    __typename\\n    ... on Identity {\\n      id\\n      name\\n    }\\n    ... on WorkspaceMembershipIdentityInfo {\\n      id\\n      name\\n    }\\n    ... on Node {\\n      __isNode: __typename\\n      nodeId\\n    }\\n  }\\n  ...AgentContextMenuAgentDefinitionFragment\\n  ...UpdateAgentDefinitionIsFavoriteMutation_AgentDefinition\\n}\\n\\nfragment AgentRowIdentityFragment_2hyKer on Identity {\\n  id\\n  enabledFeatureFlags\\n  ...AgentContextMenuIdentityFragment_2hyKer\\n  ...UpdateAgentDefinitionIsFavoriteMutation_Identity\\n}\\n\\nfragment AppBuilderToggleButton_Identity on Identity {\\n  id\\n  nodeId\\n  flags {\\n    hasSeenBuildMode\\n  }\\n}\\n\\nfragment BulkAgentSelectBarMoveToFolderMenu_Identity_2hyKer on Identity {\\n  id\\n  nodeId\\n  workspaceMembershipFor(input: {url: $workspaceUrl}) {\\n    workspace {\\n      id\\n      url\\n      nodeId\\n    }\\n    nodeId\\n  }\\n  agentFolders(workspaceUrl: $workspaceUrl) {\\n    folders {\\n      id\\n      clientId\\n      name\\n      parentClientId\\n      nodeId\\n    }\\n  }\\n  sharedAgentFolders(workspaceUrl: $workspaceUrl) {\\n    id\\n    ownerId\\n    clientId\\n    name\\n    parentClientId\\n    userPermissions {\\n      userId\\n      access\\n      deactivatedAt\\n    }\\n    workspacePermissions {\\n      access\\n    }\\n    agentDefinitions {\\n      id\\n      nodeId\\n    }\\n    nodeId\\n  }\\n}\\n\\nfragment BulkAgentSelectBarMoveToWorkspaceMenu_Identity_2hyKer on Identity {\\n  workspaceMembershipFor(input: {url: $workspaceUrl}) {\\n    workspace {\\n      id\\n      url\\n      nodeId\\n    }\\n    nodeId\\n  }\\n  workspaceMemberships {\\n    workspace {\\n      id\\n      name\\n      logo(size: px128x128) {\\n        url\\n      }\\n      nodeId\\n    }\\n    nodeId\\n  }\\n  agentFolders(workspaceUrl: $workspaceUrl) {\\n    root {\\n      agentDefinitions {\\n        id\\n        name\\n        nodeId\\n      }\\n    }\\n    folders {\\n      agentDefinitions {\\n        id\\n        name\\n        nodeId\\n      }\\n      nodeId\\n    }\\n  }\\n  sharedAgentDefinitions(workspaceUrl: $workspaceUrl) {\\n    id\\n    name\\n    nodeId\\n  }\\n  ...MoveAgentDefinitionsToWorkspaceMutation_Identity_2hyKer\\n}\\n\\nfragment BulkAgentSelectBar_Identity_2hyKer on Identity {\\n  workspaceMembershipFor(input: {url: $workspaceUrl}) {\\n    workspace {\\n      url\\n      nodeId\\n    }\\n    nodeId\\n  }\\n  ...BulkAgentSelectBarMoveToWorkspaceMenu_Identity_2hyKer\\n  ...BulkAgentSelectBarMoveToFolderMenu_Identity_2hyKer\\n  ...DeleteAgentsMutationFragment_2hyKer\\n}\\n\\nfragment CopyAgentDefinitionMutationIdentityFragment_2hyKer on Identity {\\n  id\\n  nodeId\\n  favorites: agentDefinitions(filters: {isFavorite: true, workspaceUrl: $workspaceUrl}, sortBy: [{field: LAST_RUN_AT, direction: DESC}, {field: CREATED_AT, direction: DESC}]) {\\n    nodeId\\n    id\\n    name\\n    lastRunAt\\n    createdAt\\n    notificationsCount\\n    isMuted\\n    isFavorite\\n    icon {\\n      name\\n      color\\n    }\\n  }\\n  recentLindies: agentDefinitions(limit: 6, filters: {ownedOrUsedOnly: true, workspaceUrl: $workspaceUrl}, sortBy: [{field: LAST_RUN_AT, direction: DESC}, {field: CREATED_AT, direction: DESC}]) {\\n    nodeId\\n    id\\n    name\\n    lastRunAt\\n    createdAt\\n    notificationsCount\\n    isMuted\\n    isFavorite\\n    icon {\\n      name\\n      color\\n    }\\n  }\\n  agentFolders(workspaceUrl: $workspaceUrl) {\\n    root {\\n      agentDefinitions {\\n        id\\n        nodeId\\n        name\\n        icon {\\n          name\\n          color\\n        }\\n        createdAt\\n      }\\n    }\\n    folders {\\n      id\\n      nodeId\\n      agentDefinitions {\\n        id\\n        nodeId\\n        name\\n        icon {\\n          name\\n          color\\n        }\\n        createdAt\\n      }\\n    }\\n  }\\n}\\n\\nfragment CreateAgentMutationIdentityFragment_2hyKer on Identity {\\n  id\\n  nodeId\\n  name\\n  email\\n  avatar {\\n    url\\n  }\\n  favorites: agentDefinitions(filters: {isFavorite: true, workspaceUrl: $workspaceUrl}, sortBy: [{field: LAST_RUN_AT, direction: DESC}, {field: CREATED_AT, direction: DESC}]) {\\n    nodeId\\n    id\\n    name\\n    lastRunAt\\n    createdAt\\n    notificationsCount\\n    isMuted\\n    icon {\\n      name\\n      color\\n    }\\n  }\\n  recentLindies: agentDefinitions(limit: 6, filters: {ownedOrUsedOnly: true, workspaceUrl: $workspaceUrl}, sortBy: [{field: LAST_RUN_AT, direction: DESC}, {field: CREATED_AT, direction: DESC}]) {\\n    nodeId\\n    id\\n    name\\n    lastRunAt\\n    createdAt\\n    notificationsCount\\n    isMuted\\n    icon {\\n      name\\n      color\\n    }\\n  }\\n  agentFolders(workspaceUrl: $workspaceUrl) {\\n    root {\\n      agentDefinitions {\\n        id\\n        nodeId\\n        name\\n        icon {\\n          name\\n          color\\n        }\\n      }\\n    }\\n    folders {\\n      id\\n      nodeId\\n      clientId\\n      agentDefinitions {\\n        id\\n        nodeId\\n        name\\n        icon {\\n          name\\n          color\\n        }\\n      }\\n    }\\n  }\\n  sharedAgentFolders(workspaceUrl: $workspaceUrl) {\\n    id\\n    nodeId\\n    ownerId\\n    clientId\\n    agentDefinitions {\\n      id\\n      nodeId\\n      name\\n      icon {\\n        name\\n        color\\n      }\\n    }\\n  }\\n}\\n\\nfragment CreateAgentOtherActions_Identity_2hyKer on Identity {\\n  ...CreateAgentMutationIdentityFragment_2hyKer\\n  id\\n  workspaceMembershipFor(input: {url: $workspaceUrl}) {\\n    workspace {\\n      id\\n      nodeId\\n    }\\n    nodeId\\n  }\\n}\\n\\nfragment CreateAgentTemplates_Identity_2hyKer on Identity {\\n  id\\n  email\\n  ...InstallAgent_Identity_2hyKer\\n}\\n\\nfragment CreateLindySection_Identity_2hyKer on Identity {\\n  ...AgentBuilderInputSection_Identity_2hyKer\\n  ...CreateAgentOtherActions_Identity_2hyKer\\n  ...CreateAgentTemplates_Identity_2hyKer\\n}\\n\\nfragment DeleteAgentDefinitionMutationFragment_2hyKer on Identity {\\n  id\\n  nodeId\\n  favorites: agentDefinitions(filters: {isFavorite: true, workspaceUrl: $workspaceUrl}, sortBy: [{field: LAST_RUN_AT, direction: DESC}, {field: CREATED_AT, direction: DESC}]) {\\n    nodeId\\n    id\\n    name\\n    lastRunAt\\n    createdAt\\n    notificationsCount\\n    isMuted\\n    icon {\\n      name\\n      color\\n    }\\n  }\\n  recentLindies: agentDefinitions(limit: 6, filters: {ownedOrUsedOnly: true, workspaceUrl: $workspaceUrl}, sortBy: [{field: LAST_RUN_AT, direction: DESC}, {field: CREATED_AT, direction: DESC}]) {\\n    nodeId\\n    id\\n    name\\n    lastRunAt\\n    createdAt\\n    notificationsCount\\n    isMuted\\n    icon {\\n      name\\n      color\\n    }\\n  }\\n  agentFolders(workspaceUrl: $workspaceUrl) {\\n    root {\\n      agentDefinitions {\\n        id\\n        nodeId\\n      }\\n    }\\n    folders {\\n      id\\n      nodeId\\n      agentDefinitions {\\n        id\\n        nodeId\\n      }\\n    }\\n  }\\n}\\n\\nfragment DeleteAgentFolder_Identity_2hyKer on Identity {\\n  id\\n  nodeId\\n  workspaceMembershipFor(input: {url: $workspaceUrl}) {\\n    nodeId\\n    workspace {\\n      nodeId\\n      id\\n      url\\n    }\\n  }\\n  agentFolders(workspaceUrl: $workspaceUrl) {\\n    root {\\n      agentDefinitions {\\n        id\\n        nodeId\\n      }\\n    }\\n    folders {\\n      id\\n      nodeId\\n      name\\n      clientId\\n      parentClientId\\n      agentDefinitions {\\n        id\\n        nodeId\\n      }\\n    }\\n  }\\n}\\n\\nfragment DeleteAgentsMutationFragment_2hyKer on Identity {\\n  id\\n  nodeId\\n  favorites: agentDefinitions(filters: {isFavorite: true, workspaceUrl: $workspaceUrl}, sortBy: [{field: LAST_RUN_AT, direction: DESC}, {field: CREATED_AT, direction: DESC}]) {\\n    nodeId\\n    id\\n    name\\n    lastRunAt\\n    createdAt\\n    notificationsCount\\n    isMuted\\n    icon {\\n      name\\n      color\\n    }\\n  }\\n  recentLindies: agentDefinitions(limit: 6, filters: {ownedOrUsedOnly: true, workspaceUrl: $workspaceUrl}, sortBy: [{field: LAST_RUN_AT, direction: DESC}, {field: CREATED_AT, direction: DESC}]) {\\n    nodeId\\n    id\\n    name\\n    lastRunAt\\n    createdAt\\n    notificationsCount\\n    isMuted\\n    icon {\\n      name\\n      color\\n    }\\n  }\\n  agentFolders(workspaceUrl: $workspaceUrl) {\\n    root {\\n      agentDefinitions {\\n        id\\n        nodeId\\n      }\\n    }\\n    folders {\\n      id\\n      nodeId\\n      agentDefinitions {\\n        id\\n        nodeId\\n      }\\n    }\\n  }\\n}\\n\\nfragment EnableCustomizableFieldsBanner_AgentDefinition on AgentDefinition {\\n  id\\n  isCustomizable\\n  ownerInfo {\\n    __typename\\n    ... on WorkspaceMembershipIdentityInfo {\\n      id\\n    }\\n    ... on Identity {\\n      id\\n    }\\n    ... on Node {\\n      __isNode: __typename\\n      nodeId\\n    }\\n  }\\n}\\n\\nfragment FolderRow_AgentFolder on AgentFolder {\\n  parentClientId\\n  agentDefinitions {\\n    id\\n    name\\n    nodeId\\n  }\\n  userPermissions {\\n    userId\\n    access\\n    deactivatedAt\\n  }\\n  workspacePermissions {\\n    access\\n  }\\n  ...ShareFolderModal_AgentFolder\\n}\\n\\nfragment FolderRow_Identity_2hyKer on Identity {\\n  id\\n  workspaceMembershipFor(input: {url: $workspaceUrl}) {\\n    workspace {\\n      id\\n      memberships(first: 100) {\\n        edges {\\n          node {\\n            membershipIdentityInfo {\\n              id\\n              name\\n              nodeId\\n            }\\n            nodeId\\n          }\\n        }\\n      }\\n      nodeId\\n    }\\n    nodeId\\n  }\\n  ...ShareFolderModal_Identity_2hyKer\\n}\\n\\nfragment InstallAgentContent_Identity_2hyKer on Identity {\\n  id\\n  ...InstallAgentMutation_Identity_2hyKer\\n}\\n\\nfragment InstallAgentLoader_Identity_2hyKer on Identity {\\n  ...InstallAgentContent_Identity_2hyKer\\n}\\n\\nfragment InstallAgentMutation_Identity_2hyKer on Identity {\\n  id\\n  nodeId\\n  recentLindies: agentDefinitions(limit: 6, filters: {ownedOrUsedOnly: true, workspaceUrl: $workspaceUrl}, sortBy: [{field: LAST_RUN_AT, direction: DESC}, {field: CREATED_AT, direction: DESC}]) {\\n    nodeId\\n    id\\n    name\\n    lastRunAt\\n    createdAt\\n    notificationsCount\\n    isMuted\\n    icon {\\n      name\\n      color\\n    }\\n  }\\n}\\n\\nfragment InstallAgent_Identity_2hyKer on Identity {\\n  ...InstallAgentLoader_Identity_2hyKer\\n  ...InstallMultipleAgents_Identity_2hyKer\\n}\\n\\nfragment InstallAgentsMutation_Identity_2hyKer on Identity {\\n  id\\n  nodeId\\n  recentLindies: agentDefinitions(limit: 6, filters: {ownedOrUsedOnly: true, workspaceUrl: $workspaceUrl}, sortBy: [{field: LAST_RUN_AT, direction: DESC}, {field: CREATED_AT, direction: DESC}]) {\\n    nodeId\\n    id\\n    name\\n    lastRunAt\\n    createdAt\\n    notificationsCount\\n    isMuted\\n    icon {\\n      name\\n      color\\n    }\\n  }\\n}\\n\\nfragment InstallMultipleAgents_Identity_2hyKer on Identity {\\n  id\\n  ...InstallAgentsMutation_Identity_2hyKer\\n}\\n\\nfragment MoveAgentDefinitionsToWorkspaceMutation_Identity_2hyKer on Identity {\\n  id\\n  nodeId\\n  favorites: agentDefinitions(filters: {isFavorite: true, workspaceUrl: $workspaceUrl}, sortBy: [{field: LAST_RUN_AT, direction: DESC}, {field: CREATED_AT, direction: DESC}]) {\\n    nodeId\\n    id\\n    name\\n    lastRunAt\\n    createdAt\\n    notificationsCount\\n    isMuted\\n    icon {\\n      name\\n      color\\n    }\\n  }\\n  recentLindies: agentDefinitions(limit: 6, filters: {ownedOrUsedOnly: true, workspaceUrl: $workspaceUrl}, sortBy: [{field: LAST_RUN_AT, direction: DESC}, {field: CREATED_AT, direction: DESC}]) {\\n    nodeId\\n    id\\n    name\\n    lastRunAt\\n    createdAt\\n    notificationsCount\\n    isMuted\\n    icon {\\n      name\\n      color\\n    }\\n  }\\n  agentFolders(workspaceUrl: $workspaceUrl) {\\n    root {\\n      agentDefinitions {\\n        id\\n        nodeId\\n      }\\n    }\\n    folders {\\n      id\\n      nodeId\\n      agentDefinitions {\\n        id\\n        nodeId\\n      }\\n    }\\n  }\\n}\\n\\nfragment MoveToFolderContextMenuItem_AgentDefinition on AgentDefinition {\\n  id\\n  name\\n}\\n\\nfragment MoveToFolderContextMenuItem_Identity_2hyKer on Identity {\\n  id\\n  nodeId\\n  workspaceMembershipFor(input: {url: $workspaceUrl}) {\\n    workspace {\\n      id\\n      url\\n      nodeId\\n    }\\n    nodeId\\n  }\\n  agentFolders(workspaceUrl: $workspaceUrl) {\\n    folders {\\n      id\\n      clientId\\n      name\\n      parentClientId\\n      nodeId\\n    }\\n  }\\n  sharedAgentFolders(workspaceUrl: $workspaceUrl) {\\n    id\\n    ownerId\\n    clientId\\n    name\\n    parentClientId\\n    userPermissions {\\n      userId\\n      access\\n      deactivatedAt\\n    }\\n    workspacePermissions {\\n      access\\n    }\\n    agentDefinitions {\\n      id\\n      nodeId\\n    }\\n    nodeId\\n  }\\n}\\n\\nfragment MoveToWorkspaceConfirmModal_AgentDefinition on AgentDefinition {\\n  name\\n  workspace {\\n    name\\n    nodeId\\n  }\\n  hasUsers\\n  hasEditors\\n  stateGraph {\\n    nodes {\\n      __typename\\n      ... on EntryPointTriggerNode {\\n        triggerDefinition {\\n          tool {\\n            tool\\n            nodeId\\n          }\\n          name\\n          nodeId\\n        }\\n      }\\n      ... on Node {\\n        __isNode: __typename\\n        nodeId\\n      }\\n    }\\n    nodeId\\n  }\\n}\\n\\nfragment MoveToWorkspaceContextMenuItem_AgentDefinition on AgentDefinition {\\n  ...MoveToWorkspaceConfirmModal_AgentDefinition\\n}\\n\\nfragment MoveToWorkspaceContextMenuItem_Identity_2hyKer on Identity {\\n  workspaceMemberships {\\n    workspace {\\n      id\\n      name\\n      url\\n      logo(size: px128x128) {\\n        url\\n      }\\n      nodeId\\n    }\\n    nodeId\\n  }\\n  ...MoveAgentDefinitionsToWorkspaceMutation_Identity_2hyKer\\n}\\n\\nfragment MyLindiesContentSection_Identity_2hyKer on Identity {\\n  id\\n  nodeId\\n  enabledFeatureFlags\\n  workspaceMembershipFor(input: {url: $workspaceUrl}) {\\n    workspace {\\n      id\\n      memberships(first: 100) {\\n        totalCount\\n        edges {\\n          node {\\n            membershipIdentityInfo {\\n              id\\n              name\\n              nodeId\\n            }\\n            nodeId\\n          }\\n        }\\n      }\\n      nodeId\\n    }\\n    nodeId\\n  }\\n  agentFolders(workspaceUrl: $workspaceUrl) {\\n    root {\\n      agentDefinitions {\\n        __typename\\n        id\\n        nodeId\\n        name\\n        enabled\\n        lastRunAt\\n        uniqueTools {\\n          tool\\n          displayName\\n          nodeId\\n        }\\n        permission\\n        ownerInfo {\\n          __typename\\n          ... on Identity {\\n            id\\n            name\\n          }\\n          ... on WorkspaceMembershipIdentityInfo {\\n            id\\n            name\\n          }\\n          ... on Node {\\n            __isNode: __typename\\n            nodeId\\n          }\\n        }\\n        ...AgentRowAgentDefinitionFragment\\n      }\\n    }\\n    folders {\\n      __typename\\n      id\\n      nodeId\\n      name\\n      clientId\\n      parentClientId\\n      userPermissions {\\n        userId\\n        access\\n        source\\n        deactivatedAt\\n      }\\n      workspacePermissions {\\n        access\\n        source\\n      }\\n      ...ShareFolderModal_AgentFolder\\n      ...FolderRow_AgentFolder\\n      agentDefinitions {\\n        __typename\\n        id\\n        nodeId\\n        lastRunAt\\n        name\\n        enabled\\n        uniqueTools {\\n          tool\\n          displayName\\n          nodeId\\n        }\\n        permission\\n        ownerInfo {\\n          __typename\\n          ... on Identity {\\n            id\\n            name\\n          }\\n          ... on WorkspaceMembershipIdentityInfo {\\n            id\\n            name\\n          }\\n          ... on Node {\\n            __isNode: __typename\\n            nodeId\\n          }\\n        }\\n        ...AgentRowAgentDefinitionFragment\\n      }\\n    }\\n  }\\n  sharedAgentDefinitions(workspaceUrl: $workspaceUrl) {\\n    __typename\\n    id\\n    nodeId\\n    lastRunAt\\n    name\\n    enabled\\n    uniqueTools {\\n      tool\\n      displayName\\n      nodeId\\n    }\\n    permission\\n    ownerInfo {\\n      __typename\\n      ... on Identity {\\n        id\\n        name\\n      }\\n      ... on Node {\\n        __isNode: __typename\\n        nodeId\\n      }\\n    }\\n    ...AgentRowAgentDefinitionFragment\\n  }\\n  sharedAgentFolders(workspaceUrl: $workspaceUrl) {\\n    __typename\\n    id\\n    nodeId\\n    ownerId\\n    name\\n    clientId\\n    parentClientId\\n    userPermissions {\\n      userId\\n      access\\n      source\\n      deactivatedAt\\n    }\\n    workspacePermissions {\\n      access\\n      source\\n    }\\n    ...ShareFolderModal_AgentFolder\\n    ...FolderRow_AgentFolder\\n    agentDefinitions {\\n      __typename\\n      id\\n      nodeId\\n      lastRunAt\\n      name\\n      enabled\\n      uniqueTools {\\n        tool\\n        displayName\\n        nodeId\\n      }\\n      permission\\n      ownerInfo {\\n        __typename\\n        ... on Identity {\\n          id\\n          name\\n        }\\n        ... on Node {\\n          __isNode: __typename\\n          nodeId\\n        }\\n      }\\n      ...AgentRowAgentDefinitionFragment\\n    }\\n  }\\n  ...AgentRowIdentityFragment_2hyKer\\n  ...CreateLindySection_Identity_2hyKer\\n  ...DeleteAgentFolder_Identity_2hyKer\\n  ...BulkAgentSelectBar_Identity_2hyKer\\n  ...ShareFolderModal_Identity_2hyKer\\n  ...FolderRow_Identity_2hyKer\\n}\\n\\nfragment PromptStarterSection_Identity on Identity {\\n  customizations {\\n    homePageCustomizations {\\n      chatPromptStarters {\\n        text\\n        icon\\n        prompt\\n      }\\n      appBuilderPromptStarters {\\n        text\\n        icon\\n        prompt\\n      }\\n    }\\n  }\\n}\\n\\nfragment SendWorkspaceInvitationsMutation_Workspace on Workspace {\\n  id\\n  nodeId\\n  pendingInvitations(first: 100) {\\n    edges {\\n      node {\\n        id\\n        nodeId\\n        email\\n        role\\n        __typename\\n      }\\n      cursor\\n    }\\n    pageInfo {\\n      endCursor\\n      hasNextPage\\n    }\\n  }\\n}\\n\\nfragment ShareAgentModalV2_AgentDefinition on AgentDefinition {\\n  id\\n  name\\n  parentFolder {\\n    id\\n    name\\n    nodeId\\n  }\\n  ownerInfo {\\n    __typename\\n    ... on WorkspaceMembershipIdentityInfo {\\n      __typename\\n      id\\n      name\\n      email\\n    }\\n    ... on Identity {\\n      __typename\\n      id\\n      name\\n      email\\n    }\\n    ... on Node {\\n      __isNode: __typename\\n      nodeId\\n    }\\n  }\\n  workspace {\\n    id\\n    name\\n    url\\n    groups {\\n      id\\n      name\\n      description\\n      color\\n      memberCount\\n      memberIds\\n      nodeId\\n    }\\n    billingInfo {\\n      __typename\\n      ... on SubscriptionInfo {\\n        __typename\\n        subscriptionPlan {\\n          planType\\n          nodeId\\n        }\\n      }\\n      ... on Node {\\n        __isNode: __typename\\n        nodeId\\n      }\\n    }\\n    ...ShareAgentWorkspacePermissionsRow_Workspace\\n    ...SendWorkspaceInvitationsMutation_Workspace\\n    ...UpgradeToTeamPlanContentHeader_Workspace\\n    ...UpgradeToTeamPlanContent_Workspace\\n    nodeId\\n  }\\n  permission\\n  groupPermissions {\\n    groupId\\n    access\\n    source\\n  }\\n  effectiveUserPermissions {\\n    access\\n    sources\\n    folderAccess\\n    user {\\n      id\\n      name\\n      email\\n      avatar {\\n        url\\n      }\\n      nodeId\\n    }\\n  }\\n  effectiveWorkspacePermission {\\n    access\\n    sources\\n    folderAccess\\n  }\\n  sharing {\\n    visibility\\n  }\\n  isUsableByUsers\\n  ...ShareAgentRow_AgentDefinition\\n  ...ShareAgentWorkspacePermissionsRow_AgentDefinition\\n  ...SharePermi