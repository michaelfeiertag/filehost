            "text": "{\"query\":\"query TasksContentSectionPrefetchQuery(\\n  $nodeId: ID!\\n  $workspaceUrl: String!\\n  $shouldShowAllWizardTasks: Boolean\\n) {\\n  ...TasksContentSection_Query_4c4oCW\\n}\\n\\nfragment ActionCardFormBuilder_AgentDefinition_1lASWf on AgentDefinition {\\n  ...FormBuilder_AgentDefinition_1lASWf\\n}\\n\\nfragment ActionCardFormBuilder_Identity_2hyKer on Identity {\\n  ...FormBuilder_Identity_2hyKer\\n}\\n\\nfragment ActionCardMemoryForm_AgentDefinition on AgentDefinition {\\n  icon {\\n    name\\n    color\\n  }\\n}\\n\\nfragment ActionCardTestAgent_AgentDefinition on AgentDefinition {\\n  id\\n}\\n\\nfragment AgentEnabledSwitch_AgentDefinition on AgentDefinition {\\n  id\\n  enabled\\n  ownerInfo {\\n    __typename\\n    ... on WorkspaceMembershipIdentityInfo {\\n      __typename\\n      id\\n    }\\n    ... on Identity {\\n      __typename\\n      id\\n    }\\n    ... on Node {\\n      __isNode: __typename\\n      nodeId\\n    }\\n  }\\n  stateGraphOverrides {\\n    enabled\\n  }\\n  ...useSaveAgentWithPremiumModal_AgentDefinition\\n  ...useDiscardDraft_AgentDefinition\\n}\\n\\nfragment AgentEnabledSwitch_Identity_2hyKer on Identity {\\n  enabledFeatureFlags\\n  workspaceMembershipFor(input: {url: $workspaceUrl}) {\\n    workspace {\\n      billingInfo {\\n        __typename\\n        ... on SubscriptionInfo {\\n          subscriptionPlan {\\n            planType\\n            nodeId\\n          }\\n        }\\n        ... on WorkspacePublicBillingInfo {\\n          subscriptionPlan {\\n            planType\\n            nodeId\\n          }\\n        }\\n        ... on Node {\\n          __isNode: __typename\\n          nodeId\\n        }\\n      }\\n      nodeId\\n    }\\n    nodeId\\n  }\\n  ...useSaveAgentWithPremiumModal_Identity_2hyKer\\n}\\n\\nfragment AgentStateActionTile_Identity_2hyKer on Identity {\\n  enabledFeatureFlags\\n  ...PremiumFeature_Identity_2hyKer\\n}\\n\\nfragment AgentStateActions_Identity_2hyKer on Identity