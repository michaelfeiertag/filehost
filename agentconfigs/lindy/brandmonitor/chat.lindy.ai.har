            "mimeType": "application/json",
            "text": "{\"query\":\"query HomeContentPrefetchQuery(\\n  $workspaceUrl: String!\\n) {\\n  me {\\n    ...HomeContent_Identity_2hyKer\\n    nodeId\\n  }\\n  ...HomeContent_agentMarketplace\\n}\\n\\nfragment AgentBuilderSection_Identity_2hyKer on Identity {\\n  flags {\\n    isLindyAssistant\\n  }\\n  ...AgentBuilderTaskInput_Identity_2hyKer\\n  agentBuilderAgentDefinition {\\n    ...AgentBuilderTaskInput_AgentDefinition\\n    ...useTaskInput_AgentDefinition\\n    nodeId\\n  }\\n  ...useAgentBuilderAgentIds_Identity\\n  ...AgentBuilderSection_useModeToDetails_Identity\\n  ...PromptStarterSection_Identity\\n}\\n\\nfragment AgentBuilderSection_useModeToDetails_Identity on Identity {\\n  customizations {\\n    homePageCustomizations {\\n      chatTitle\\n      appBuilderTitle\\n      chatInputPlaceholder\\n      appBuilderInputPlaceholder\\n    }\\n  }\\n}\\n\\nfragment AgentBuilderTaskInput_AgentDefinition on AgentDefinition {\\n  ...SpeechToTextControl_AgentDefinition\\n}\\n\\nfragment AgentBuilderTaskInput_Identity_2hyKer on Identity {\\n  flags {\\n    isLindyAssistant\\n  }\\n  ...AppBuilderToggleButton_Identity\\n  ...SpeechToTextControl_Identity_2hyKer\\n}\\n\\nfragment AgentsPreinstalled_Identity_2hyKer on Identity {\\n  id\\n  nodeId\\n  flags {\\n    dismissedWelcomeBanner\\n  }\\n  workspaceMembershipFor(input: {url: $workspaceUrl}) {\\n    initiallyInstalledAgentDefinitions {\\n      id\\n      name\\n      summary\\n      icon {\\n        name\\n        color\\n      }\\n      nodeId\\n    }\\n    nodeId\\n  }\\n}\\n\\nfragment AgentsShared_Identity_2hyKer on Identity {\\n  sharedAgentsByRecentTaskCount(workspaceUrl: $workspaceUrl, first: 6) {\\n    edges {\\n      node {\\n        id\\n        name\\n        summary\\n        icon {\\n          color\\n          name\\n        }\\n        nodeId\\n        __typename\\n      }\\n      cursor\\n    }\\n    pageInfo {\\n      hasNextPage\\n      endCursor\\n    }\\n  }\\n}\\n\\nfragment AppBuilderToggleButton_Identity on Identity {\\n  id\\n  nodeId\\n  flags {\\n    hasSeenBuildMode\\n  }\\n}\\n\\nfragment AssistantHomeSection_Identity_2hyKer on Identity {\\n  name\\n  managedAgent(workspaceUrl: $workspaceUrl, managedAgentType: CHIEF_OF_STAFF) {\\n    id\\n    name\\n    ...useTaskInput_AgentDefinition\\n    ...SpeechToTextControl_AgentDefinition\\n    nodeId\\n  }\\n  ...SpeechToTextControl_Identity_2hyKer\\n  ...TodoList_Identity\\n}\\n\\nfragment HomeContent_Identity_2hyKer on Identity {\\n  id\\n  email\\n  name\\n  flags {\\n    isLindyAssistant\\n    signedUpFromLindyBuild\\n    hasSeenBuildMode\\n  }\\n  workspaceMembershipFor(input: {url: $workspaceUrl}) {\\n    workspace {\\n      ...JoinedWorkspaceModal_Workspace\\n      nodeId\\n    }\\n    nodeId\\n  }\\n  ...AgentBuilderSection_Identity_2hyKer\\n  ...AgentsPreinstalled_Identity_2hyKer\\n  ...AgentsShared_Identity_2hyKer\\n  ...InstallAgent_Identity_2hyKer\\n  ...WelcomeVideo_Identity\\n  ...AssistantHomeSection_Identity_2hyKer\\n}\\n\\nfragment HomeContent_agentMarketplace on Query {\\n  agentMarketplace(input: {}) {\\n    categoryLabel\\n    categorySlug\\n    agentDefinitions(first: 4) {\\n      edges {\\n        node {\\n          id\\n          name\\n          summary\\n          icon {\\n            color\\n            name\\n          }\\n          nodeId\\n        }\\n      }\\n    }\\n  }\\n}\\n\\nfragment InstallAgentContent_Identity_2hyKer on Identity {\\n  id\\n  ...InstallAgentMutation_Identity_2hyKer\\n}\\n\\nfragment InstallAgentLoader_Identity_2hyKer on Identity {\\n  ...InstallAgentContent_Identity_2hyKer\\n}\\n\\nfragment InstallAgentMutation_Identity_2hyKer on Identity {\\n  id\\n  nodeId\\n  recentLindies: agentDefinitions(limit: 6, filters: {ownedOrUsedOnly: true, workspaceUrl: $workspaceUrl}, sortBy: [{field: LAST_RUN_AT, direction: DESC}, {field: CREATED_AT, direction: DESC}]) {\\n    nodeId\\n    id\\n    name\\n    lastRunAt\\n    createdAt\\n    notificationsCount\\n    isMuted\\n    icon {\\n      name\\n      color\\n    }\\n  }\\n}\\n\\nfragment InstallAgent_Identity_2hyKer on Identity {\\n  ...InstallAgentLoader_Identity_2hyKer\\n  ...InstallMultipleAgents_Identity_2hyKer\\n}\\n\\nfragment InstallAgentsMutation_Identity_2hyKer on Identity {\\n  id\\n  nodeId\\n  recentLindies: agentDefinitions(limit: 6, filters: {ownedOrUsedOnly: true, workspaceUrl: $workspaceUrl}, sortBy: [{field: LAST_RUN_AT, direction: DESC}, {field: CREATED_AT, direction: DESC}]) {\\n    nodeId\\n    id\\n    name\\n    lastRunAt\\n    createdAt\\n    notificationsCount\\n    isMuted\\n    icon {\\n      name\\n      color\\n    }\\n  }\\n}\\n\\nfragment InstallMultipleAgents_Identity_2hyKer on Identity {\\n  id\\n  ...InstallAgentsMutation_Identity_2hyKer\\n}\\n\\nfragment JoinedWorkspaceModal_Workspace on Workspace {\\n  name\\n  logo(size: px128x128) {\\n    url\\n  }\\n  memberships(first: 100) {\\n    totalCount\\n  }\\n}\\n\\nfragment PromptStarterSection_Identity on Identity {\\n  customizations {\\n    homePageCustomizations {\\n      chatPromptStarters {\\n        text\\n        icon\\n        prompt\\n      }\\n      appBuilderPromptStarters {\\n        text\\n        icon\\n        prompt\\n      }\\n    }\\n  }\\n}\\n\\nfragment SpeechToTextControl_AgentDefinition on AgentDefinition {\\n  flags {\\n    defaultSpeechToTextModel\\n    isSpeechToTextModalMode\\n  }\\n}\\n\\nfragment SpeechToTextControl_Identity_2hyKer on Identity {\\n  flags {\\n    isMarkedSensitive\\n  }\\n  workspaceMembershipFor(input: {url: $workspaceUrl}) {\\n    membershipSettings {\\n      speechToTextModel\\n    }\\n    nodeId\\n  }\\n}\\n\\nfragment TodoList_Identity on Identity {\\n  enabledFeatureFlags\\n  todoListItems {\\n    edges {\\n      node {\\n        id\\n        title\\n        description\\n        status\\n        nodeId\\n      }\\n    }\\n  }\\n}\\n\\nfragment WelcomeVideo_Identity on Identity {\\n  id\\n  welcomeVideoUrl\\n  flags {\\n    welcomeVideoViewedAt\\n  }\\n}\\n\\nfragment useAgentBuilderAgentIds_Identity on Identity {\\n  agentBuilderAgentDefinition {\\n    id\\n    name\\n    nodeId\\n  }\\n}\\n\\nfragment useTaskInput_AgentDefinition on AgentDefinition {\\n  id\\n  url\\n}\\n\",\"variables\":{\"workspaceUrl\":\"michael-feiertags-workspace-2\"}}",
            "params": []
          }
