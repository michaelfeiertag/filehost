Id\":null,\"statefulToolKey\":null,\"action\":{\"authConfig\":null,\"dynamicLoaders\":null,\"key\":\"setVariable\",\"tool\":\"Lindy\",\"toolDisplayName\":\"Lindy utilities\",\"imageUrl\":null,\"description\":\"Sets a variable with a specified name and value that will exist for the duration of the task run. Useful for refering to the same value across multiple steps.\",\"displayName\":\"Set variable\",\"outputSchema\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\",\"description\":\"The name of the variable.\"},\"value\":{\"type\":\"string\",\"description\":\"The value of the variable.\"}},\"required\":[\"name\",\"value\"],\"additionalProperties\":false},\"deprecated\":false,\"observableChannel\":null,\"hasSideEffects\":false,\"isPremium\":false,\"premiumActionCost\":null,\"showActionGuidelines\":false,\"nodeId\":\"QWN0aW9uRGV0YWlsczpMaW5keS5zZXRWYXJpYWJsZS42OGY4MzM5NTMwNzFiNDYzODVhYTExNDguNjg0MjFjYjdjMjJkNzQwMmU4MWY1ZmM5\",\"dependencies\":[],\"inputSchema\":{\"type\":\"object\",\"required\":[\"name\",\"value\"],\"properties\":{\"name\":{\"type\":\"string\",\"minLength\":1,\"description\":\"The name for this variable. Must not be empty.\",\"lindyMetadata\":{\"defaultMode\":\"manual\"}},\"value\":{\"type\":\"string\",\"description\":\"The value for this variable.\",\"lindyMetadata\":{\"defaultMode\":\"manual\"}}},\"additionalProperties\":false},\"outputProperties\":[{\"displayName\":null,\"type\":\"String\",\"value\":\"name\",\"schema\":{\"type\":\"string\",\"description\":\"The name of the variable.\"}},{\"displayName\":null,\"type\":\"String\",\"value\":\"value\",\"schema\":{\"type\":\"string\",\"description\":\"The value of the variable.\"}}],\"inputTree\":null},\"tool\":{\"description\":\"A collection of useful actions to help you manage your tasks in Lindy.\",\"displayName\":\"Lindy utilities\",\"isPopular\":true,\"tool\":\"Lindy\",\"nodeId\":\"VG9vbDpMaW5keQ==\"}}},{\"__typename\":\"ActionNode\",\"__isNode\":\"ActionNode\",\"id\":\"68f8339530