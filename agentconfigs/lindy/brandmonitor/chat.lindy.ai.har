            "text": "{\"query\":\"query ActionConfigActionConfigFetchQuery(\\n  $nodeId: ID!\\n  $dependentValues: JSONObject\\n  $authId: ID\\n  $setFields: JSONObject!\\n  $agentDefinitionId: ID\\n) {\\n  node(id: $nodeId) {\\n    __typename\\n    ... on ActionDetails {\\n      inputSchema(dependentValues: $dependentValues, authId: $authId, agentDefinitionId: $agentDefinitionId)\\n      inputTree(input: {setFields: $setFields, authId: $authId, agentDefinitionId: $agentDefinitionId}) {\\n        __typename\\n        ... on InputTreeStaticField {\\n          field\\n          isParentField\\n          schema\\n          parentFields\\n          required\\n        }\\n        ... on InputTreeDynamicField {\\n          output\\n          field\\n          displayName\\n          description\\n          isParentField\\n          icon\\n          key\\n          placeholder\\n          defaultValue {\\n            value\\n            name\\n          }\\n          parentFields\\n          required\\n          dinFieldToken\\n        }\\n        ... on InputTreeMetadataField {\\n          value\\n          field\\n        }\\n        ... on InputTreeDynamicFieldProjection {\\n          field\\n          displayName\\n          description\\n          key\\n          parentFields\\n          required\\n          isParentField\\n          output\\n        }\\n        ... on InputTreeAlertField {\\n          alertType\\n          message\\n        }\\n      }\\n    }\\n    nodeId\\n  }\\n}\\n\",\"variables\":{\"nodeId\":\"QWN0aW9uRGV0YWlsczpCcm93c2VyLnNlYXJjaC42OTVkN2MwYjE3ZDIxM2U1NjA0NTc2MWM=\",\"dependentValues\":null,\"authId\":null,\"setFields\":{},\"agentDefinitionId\":\"695d7c0b17d213e56045761c\"}}",
