y_2hyKer\\n  ...CustomizableFieldFormNodeSection_Identity_2hyKer\\n}\\n\\nfragment CustomizableFieldFormNodeSection_Identity_2hyKer on Identity {\\n  workspaceMembershipFor(input: {url: $workspaceUrl}) {\\n    workspace {\\n      id\\n      nodeId\\n    }\\n    nodeId\\n  }\\n  ...EntryPointNodeTriggerEditorWithTrigger_Identity_2hyKer\\n}\\n\\nfragment CustomizableFieldFormNodeSection_StateGraphNodeCustomizationConfig on StateGraphNodeCustomizationConfig {\\n  __isStateGraphNodeCustomizationConfig: __typename\\n  ... on ActionNodeCustomizationConfig {\\n    __typename\\n    id\\n    fields {\\n      displayName\\n    }\\n    requireConfirmation\\n    customizableAuth\\n    model\\n  }\\n  ... on AgentStateCustomizationConfig {\\n    __typename\\n    id\\n    requireConfirmation\\n    guidelines\\n    prompt\\n    model\\n  }\\n  ... on EntryPointNodeCustomizationConfig {\\n    __typename\\n    id\\n    fields {\\n      displayName\\n    }\\n    customizableAuth\\n  }\\n  ... on LogicNodeCustomizationConfig {\\n    __typename\\n    id\\n    model\\n  }\\n}\\n\\nfragment DeleteAgentDefinitionMutationFragment_2hyKer on Identity {\\n  id\\n  nodeId\\n  favorites: agentDefinitions(filters: {isFavorite: true, workspaceUrl: $workspaceUrl}, sortBy: [{field: LAST_RUN_AT, direction: DESC}, {field: CREATED_AT, direction: DESC}]) {\\n    nodeId\\n    id\\n    name\\n    lastRunAt\\n    createdAt\\n    notificationsCount\\n    isMuted\\n    icon {\\n      name\\n      color\\n    }\\n  }\\n  recentLindies: agentDefinitions(limit: 6, filters: {ownedOrUsedOnly: true, workspaceUrl: $workspaceUrl}, sortBy: [{field: LAST_RUN_AT, direction: DESC}, {field: CREATED_AT, direction: DESC}]) {\\n    nodeId\\n    id\\n    name\\n    lastRunAt\\n    createdAt\\n    notificationsCount\\n    isMuted\\n    icon {\\n      name\\n      color\\n    }\\n  }\\n  agentFolders(workspaceUrl: $workspaceUrl) {\\n    root {\\n      agentDefinitions {\\n        id\\n        nodeId\\n      }\\n    }\\n    fo