            "text": "{\"data\":{\"agentMarketplace\":[{\"categoryLabel\":\"Sales\",\"categorySlug\":\"sales\",\"agentDefinitions\":{\"edges\":[{\"node\":{\"id\":\"6682f02c9e3c8a5da9bdf21c\",\"name\":\"Sales Meeting Recorder\",\"summary\":\"Take notes during sales calls and automatically update your CRM\",\"nodeId\":\"QWdlbnREZWZpbml0aW9uOjY2ODJmMDJjOWUzYzhhNWRhOWJkZjIxYw==\",\"icon\":{\"color\":\"Yellow\",\"name\":\"VoiceIcon\"}}},{\"node\":{\"id\":\"667f63bbd464c64c270dca9b\",\"name\":\"Lead Generator\",\"summary\":\"Find and organize leads instantly\",\"nodeId\":\"QWdlbnREZWZpbml0aW9uOjY2N2Y2M2JiZDQ2NGM2NGMyNzBkY2E5Yg==\",\"icon\":{\"color\":\"Yellow\",\"name\":\"PeopleTogetherUserAvatarGroupIcon\"}}},{\"node\":{\"id\":\"66a8214b07a1e57a25df7de4\",\"name\":\"Lead Outreacher\",\"summary\":\"Automated sales outreach and lead engagement\",\"nodeId\":\"QWdlbnREZWZpbml0aW9uOjY2YTgyMTRiMDdhMWU1N2EyNWRmN2RlNA==\",\"icon\":{\"color\":\"Yellow\",\"name\":\"EmailEnvelopeIcon\"}}},{\"node\":{\"id\":\"674e32f8f6340fbcdcb91c9f\",\"name\":\"Outbound Phone Call Agent\",\"summary\":\"Book consultations with qualified leads instantly\",\"nodeId\":\"QWdlbnREZWZpbml0aW9uOjY3NGUzMmY4ZjYzNDBmYmNkY2I5MWM5Zg==\",\"icon\":{\"color\":\"Purple\",\"name\":\"PhoneTelephoneContactIcon\"}}}]}},{\"categoryLabel\":\"Meetings\",\"categorySlug\":\"meetings\",\"agentDefinitions\":{\"edges\":[{\"node\":{\"id\":\"67044439e0f3c2fa25fdb386\",\"name\":\"Meeting Notetaker\",\"summary\":\"Captures key meeting details, sends follow-ups, and answers questions about past meetings\",\"nodeId\":\"QWdlbnREZWZpbml0aW9uOjY3MDQ0NDM5ZTBmM2MyZmEyNWZkYjM4Ng==\",\"icon\":{\"color\":\"Blue\",\"name\":\"TapeIcon\"}}},{\"node\":{\"id\":\"66bf86cd4038063cabd9a511\",\"name\":\"Meeting Scheduler\",\"summary\":\"CC Lindy to your emails, just like a real EA, and have her schedule meetings for you.\",\"nodeId\":\"QWdlbnREZWZpbml0aW9uOjY2YmY4NmNkNDAzODA2M2NhYmQ5YTUxMQ==\",\"icon\":{\"color\":\"Purple\",\"name\":\"CalendarIcon\"