            "mimeType": "application/json",
            "text": "{\"query\":\"query EditorContentSectionPrefetchQuery(\\n  $workspaceUrl: String!\\n  $nodeId: ID!\\n  $testRunId: ID!\\n  $hasTestRunId: Boolean!\\n  $wizardSubTaskId: ID!\\n  $blocksCount: Int!\\n) {\\n  ...EditorContentSection_Query_3qUMUK\\n}\\n\\nfragment ActionCardAssistantOnboardingPaywallForm_SubTask on SubTask {\\n  id\\n  nodeId\\n  state {\\n    nodeId\\n    onboarding {\\n      nodeId\\n      stage\\n      isPaywallVisible\\n    }\\n  }\\n}\\n\\nfragment ActionCardDemoChecklistForm_SubTask on SubTask {\\n  state {\\n    onboarding {\\n      stage\\n      nodeId\\n    }\\n    nodeId\\n  }\\n  ...DemoCheckList_SubTask\\n  ...DemoEmailList_SubTask\\n}\\n\\nfragment ActionCardFormBuilder_AgentDefinition_1lASWf on AgentDefinition {\\n  ...FormBuilder_AgentDefinition_1lASWf\\n}\\n\\nfragment ActionCardFormBuilder_AgentDefinition_2Qsd88 on AgentDefinition {\\n  ...FormBuilder_AgentDefinition_2Qsd88\\n}\\n\\nfragment ActionCardFormBuilder_Identity_2hyKer on Identity {\\n  ...FormBuilder_Identity_2hyKer\\n}\\n\\nfragment ActionCardFormBuilder_SubTask on SubTask {\\n  ...FormBuilder_SubTask\\n}\\n\\nfragment ActionCardMemoryForm_AgentDefinition on AgentDefinition {\\n  icon {\\n    name\\n    color\\n  }\\n}\\n\\nfragment ActionCardTestAgent_AgentDefinition on AgentDefinition {\\n  id\\n}\\n\\nfragment ActionCardTestAgent_SubTask on SubTask {\\n  id\\n}\\n\\nfragment ActionCardUpdateAgentForm_SubTask on SubTask {\\n  ...useUndoLindyAgentChanges_SubTask\\n}\\n\\nfragment ActionCardUpdateAgentForm_block on Block {\\n  ...useUndoLindyAgentChanges_Block\\n}\\n\\nfragment ActionCardUpdateAgentForm_event on TaskEventActionCall {\\n  ...useUndoLindyAgentChanges_TaskEventActionCall\\n  ...useIsAgentBuilderActionUndone_TaskEventActionCall\\n}\\n\\nfragment ActionNodeEditor_AgentDefinition on AgentDefinition {\\n  ...CustomActionNodeEditor_AgentDefinition\\n  ...NodeContextMenu_AgentDefinition\\n}\\n\\nfragment ActionNodeEditor_Identity_2hyKer on Identity {\\n  isAdmin\\n  workspaceMembershipFor(input: {url: $workspaceUrl}) {\\n    workspace {\\n      id\\n      nodeId\\n    }\\n    nodeId\\n  }\\n  ...CustomActionNodeEditor_Identity_2hyKer\\n  ...NodeContextMenu_Identity_2hyKer\\n}\\n\\nfragment ActionNode_AgentDefinition on AgentDefinition {\\n  ...CustomNode_AgentDefinition\\n}\\n\\nfragment ActionNode_Identity_2hyKer on Identity {\\n  ...CustomNode_Identity_2hyKer\\n}\\n\\nfragment AgentBuilderContentTaskView_AgentDefinition on AgentDefinition {\\n  id\\n  ...useAgentBuilderSubTaskIds_AgentDefinition\\n}\\n\\nfragment AgentBuilderContentTaskView_Identity_2hyKer on Identity {\\n  ...SubTaskViewSection_Identity_2hyKer\\n  ...useAgentBuilderAgentIds_Identity\\n  agentBuilderAgentDefinition {\\n    ...SubTaskViewSection_AgentDefinition_2Qsd88\\n    nodeId\\n  }\\n}\\n\\nfragment AgentBuilderContentTaskView_SubTask_2XfX2t on SubTask {\\n  __typename\\n  ...SubTaskViewSection_SubTask_2XfX2t\\n  ...useAutoResolveFlowRedirection_SubTask_2XfX2t\\n}\\n\\nfragment AgentBuilderContent_AgentDefinition on AgentDefinition {\\n  ...AgentBuilderContentTaskView_AgentDefinition\\n}\\n\\nfragment AgentBuilderContent_Identity_2hyKer on Identity {\\n  ...AgentBuilderContentTaskView_Identity_2hyKer\\n}\\n\\nfragment AgentBuilderContent_SubTask_2XfX2t on SubTask {\\n  ...AgentBuilderContentTaskView_SubTask_2XfX2t\\n}\\n\\nfragment AgentBuilderHeader_Identity on Identity {\\n  isAdmin\\n}\\n\\nfragment AgentBuilderHeader_SubTask on SubTask {\\n  url\\n  id\\n}\\n\\nfragment AgentBuilderStreakSectionUndo_Block on Block {\\n  ...useUndoLindyAgentChanges_Block\\n}\\n\\nfragment AgentBuilderStreakSectionUndo_SubTask on SubTask {\\n  ...useUndoLindyAgentChanges_SubTask\\n}\\n\\nfragment AgentBuilderStreakSectionUndo_TaskEventActionCall on TaskEventActionCall {\\n  ...useUndoLindyAgentChanges_TaskEventActionCall\\n  ...useIsAgentBuilderActionUndone_TaskEventActionCall\\n  ...useActionCardFormData_TaskEventActionCall\\n}\\n\\nfragment AgentBu