e\":\"string\"}}]}}},\"additionalProperties\":false},\"queryParamContext\":{\"type\":\"object\",\"additionalProperties\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"array\",\"items\":{\"type\":\"string\"}}]}}},\"required\":[\"type\",\"from\",\"message\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"type\":{\"type\":\"string\",\"const\":\"user_data\"},\"timestamp\":{\"type\":\"string\"},\"metadata\":{\"type\":\"object\",\"properties\":{\"toolCallId\":{\"type\":\"string\"}},\"additionalProperties\":false},\"id\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"email\":{\"type\":\"string\"},\"additionalData\":{}},\"required\":[\"type\"],\"additionalProperties\":false}]}}},\"required\":[\"messengerConversation\",\"newEvents\"],\"additionalProperties\":false,\"lindyMetadata\":{\"fieldsHiddenFromUI\":[\"*\"]}},\"fields\":[{\"__typename\":\"TriggerFieldLindyEmbedConfig\",\"key\":\"lindyMessengerConfig\",\"label\":\"Embed Configuration\",\"placeholder\":null,\"description\":null,\"tooltip\":null,\"isRequired\":true,\"canBeSharedWithTemplate\":false,\"type\":\"lindy_embed_custom_config\",\"fields\":[]},{\"__typename\":\"TriggerFieldAutoObserve\",\"key\":\"onAutoObserve\",\"label\":\"Follow-up message behavior\",\"placeholder\":null,\"description\":null,\"tooltip\":null,\"isRequired\":true,\"canBeSharedWithTemplate\":false,\"type\":\"auto-observe\",\"defaultValue\":\"same-task\",\"fields\":[]}],\"tool\":{\"tool\":\"LindyEmbed\",\"displayName\":\"Lindy Embed\",\"nodeId\":\"VG9vbDpMaW5keUVtYmVk\"}}},{\"__typename\":\"ActionNode\",\"__isNode\":\"ActionNode\",\"id\":\"695d7c0b17d213e56045762c\",\"type\":\"Action\",\"displayName\":\"Search the Internet for Business News\",\"layer\":[\"__BASE_LAYER__\"],\"guidelines\":null,\"manuallyPositioned\":true,\"model\":null,\"occurrence\":1,\"statefulToolOccurrence\":null,\"requireConfirmation\":\"Never\",\"specialProperties\":null,\"nodeId\":\"QWN0aW9uTm9kZTo2OTcwMmYyYWJlZmM2OTQ1MTRiOTQzZDQ6Njk1ZDdjMGIxN2QyMTNlNTYwNDU3NjJj\",\"auth\":null,\"position\":{\"x\":-328,\"y\":256},\"actionConfiguration\":[{\"type\":\"ai\",\"allowAdditionalArrayEntries\":false,\"path\":[\"query\"],\"prompt\":[\"You are a Brand Monitoring and Report Assistant. Your responsibilities are\\n\\n1. Brand Monitoring\\n   - Track and monitor a brand’s online presence by searching the internet for mentions, reviews, and discussions.\\n   - Steps:\\n     1. Search across:\\n        - Social media platforms\\n        - News sites and blogs\\n        - Review platforms\\n        - Forums and community boards\\n     2. Collect:\\n        - Source of mention\\n        - Context (positive, negative, neutral)\\n        - Date and time\\n        - Link to the mention\\n\\n   - User Input:\\n     Brand Name: \",{\"nodeId\":\"695ead5187d7df8d1b0d08f8\",\"path\":\"#\",\"type\":\"output\",\"displayName\":\"output\"},\"\\n     Keywords (optional): Laundry Detergent\\n\\n2. Report Generation\\n   - Create a summary based on the brand monitoring data.\\n   - Steps:\\n     - Overview: Briefly summarize online presence and sentiment trends (positive, negative, neutral).\\n     - Key Insights: Highlight top positive mentions, significant criticisms, and notable discussions.\\n     - Trends: Identify recurring themes and frequently discussed topics.\\n     - Metrics: Provide total mentions, sentiment breakdown, and most active platforms.\\n     - Recommendations: Suggest actions to improve or leverage brand presence.\\n\\n   - Present the report in a clear, structured format with optional visuals for trends and metrics.\",{\"nodeId\":\"695ead5187d7df8d1b0d08f8\",\"path\":\"#\",\"type\":\"output\",\"displayName\":\"output\"},{\"nodeId\":\"695ead5187d7df8d1b0d08f8\",\"path\":\"#\",\"type\":\"output\",\"displayName\":\"output\"}],\"unionType\":null,\"manualResult\":{\"isUndefined\":true,\"isNull\":false,\"value\":null}},{\"type\":\"ai\",\"allowAdditionalArrayEntries\":false,\"path\":[\"engineOptions\"],\"prompt\":[],\"unionType\":null,\"manualResult\":{\"isUndefined\":true,\"isNull\":false,\"value\":null}}],\"knowledgeSources\":[],\"actionDefinition\":{\"createdByNodeId\":null,\"statefulToolKey\":null,\"action\":{\"authConfig\":null,\"dynamicLoaders\":null,\"key\":\"search\",\"tool\":\"Browser\",\"toolDisplayName\":\"Web browser\",\"imageUrl\":null,\"description\":\"Search the Internet using a variety of search engines.\",\"displayName\":\"Search the Internet\",\"outputSchema\":{},\"deprecated\":false,\"observableChannel\":null,\"hasSideEffects\":false,\"isPremium\":true,\"premiumActionCost\":1,\"showActionGuidelines\":false,\"nodeId\":\"QWN0aW9uRGV0YWlsczpCcm93c2VyLnNlYXJjaC42OTVkN2MwYjE3ZDIxM2U1NjA0NTc2MmMuNjk1ZDdjMGIxN2QyMTNlNTYwNDU3NjFj\",\"dependencies\":[],\"inputSchema\":{\"type\":\"object\",\"required\":[\"query\"],\"properties\":{\"query\":{\"type\":\"string\",\"description\":\"The search query.\"},\"engineOptions\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"engine\":{\"type\":\"string\",\"const\":\"bing\"},\"location\":{\"type\":\"string\",\"description\":\"e.g San Francisco, CA\"}},\"required\":[\"engine\"],\"additionalProperties\":false,\"lindyMetadata\":{\"displayName\":\"Bing\"}},{\"type\":\"object\",\"properties\":{\"engine\":{\"type\":\"string\",\"const\":\"events\"},\"location\":{\"type\":\"string\",\"description\":\"e.g San Francisco, CA\"}},\"required\":[\"engine\"],\"additionalProperties\":false,\"lindyMetadata\":{\"displayName\":\"Events\"}},{\"type\":\"object\",\"properties\":{\"engine\":{\"type\":\"string\",\"const\":\"images\"},\"location\":{\"type\":\"string\",\"description\":\"e.g San Francisco, CA\"}},\"required\":[\"engine\"],\"additionalProperties\":false,\"lindyMetadata\":{\"displayName\":\"Images\"}},{\"type\":\"object\",\"properties\":{\"engine\":{\"type\":\"string\",\"const\":\"jobs\"},\"location\":{\"type\":\"string\",\"description\":\"e.g San Francisco, CA\"}},\"required\":[\"engine\"],\"additionalProperties\":false,\"lindyMetadata\":{\"displayName\":\"Jobs\"}},{\"type\":\"object\",\"properties\":{\"engine\":{\"type\":\"string\",\"const\":\"news\"},\"gl\":{\"type\":\"string\",\"description\":\"Parameter defines the country to use for the Google News search. It's a two-letter country code. (e.g., us for the United States (default), uk for United Kingdom, or fr for France). Head to the [Google countries page](https://serpapi.com/google-countries) for a full list of supported Google News countries.\"},\"location\":{\"type\":\"string\",\"description\":\"e.g San Francisco, CA\"}},\"required\":[\"engine\"],\"additionalProperties\":false,\"lindyMetadata\":{\"displayName\":\"News\"}},{\"type\":\"object\",\"properties\":{\"engine\":{\"type\":\"string\",\"const\":\"shopping\"},\"location\":{\"type\":\"string\",\"description\":\"e.g San Francisco, CA\"}},\"required\":[\"engine\"],\"additionalProperties\":false,\"lindyMetadata\":{\"displayName\":\"Shopping\"}},{\"type\":\"object\",\"properties\":{\"engine\":{\"type\":\"string\",\"const\":\"yelp\"},\"location\":{\"type\":\"string\",\"description\":\"e.g San Francisco, CA\"}},\"required\":[\"engine\"],\"additionalProperties\":false,\"lindyMetadata\":{\"displayName\":\"Yelp\"}},{\"type\":\"object\",\"properties\":{\"engine\":{\"type\":\"string\",\"const\":\"duckduckgo\"},\"kl\":{\"type\":\"string\",\"description\":\"e.g. us-en\"}},\"required\":[\"engine\"],\"additionalProperties\":false,\"lindyMetadata\":{\"displayName\":\"DuckDuckGo\"}},{\"type\":\"object\",\"properties\":{\"engine\":{\"type\":\"string\",\"const\":\"ebay\"},\"ebay_domain\":{\"type\":\"string\",\"description\":\"e.g. ebay.com\"}},\"required\":[\"engine\"],\"additionalProperties\":false,\"lindyMetadata\":{\"displayName\":\"eBay\"}},{\"type\":\"object\",\"properties\":{\"engine\":{\"type\":\"string\",\"const\":\"hotels\"},\"check_in_date\":{\"type\":\"string\",\"description\":\"YYYY-MM-DD\"},\"check_out_date\":{\"type\":\"string\",\"description\":\"YYYY-MM-DD\"},\"adults\":{\"type\":\"number\"},\"currency\":{\"type\":\"string\",\"description\":\"e.g. USD, EUR, GBP\"}},\"required\":[\"engine\",\"check_in_date\",\"check_out_date\"],\"additionalProperties\":false,\"lindyMetadata\":{\"displayName\":\"Hotels\"}},{\"type\":\"object\",\"properties\":{\"engine\":{\"type\":\"string\",\"const\":\"flights\"},\"departure_id\":{\"type\":\"string\",\"description\":\"e.g. SFO\"},\"arrival_id\":{\"type\":\"string\",\"description\":\"e.g. LHR\"},\"outbound_date\":{\"type\":\"string\",\"description\":\"YYYY-MM-DD\"},\"return_date\":{\"type\":\"string\",\"description\":\"YYYY-MM-DD\"},\"currency\":{\"type\":\"string\"}},\"required\":[\"engine\",\"departure_id\",\"arrival_id\",\"outbound_date\"],\"additionalProperties\":false,\"lindyMetadata\":{\"displayName\":\"Flights\"}},{\"type\":\"object\",\"properties\":{\"engine\":{\"type\":\"string\",\"const\":\"maps\"},\"ll\":{\"type\":\"string\",\"description\":\"e.g. @37.7676316,-122.4183248,18z\"}},\"required\":[\"engine\",\"ll\"],\"additionalProperties\":false,\"lindyMetadata\":{\"displayName\":\"Maps\"}},{\"type\":\"object\",\"properties\":{\"engine\":{\"type\":\"string\",\"const\":\"youtube\"},\"resultType\":{\"type\":\"string\",\"enum\":[\"video\",\"channel\",\"playlist\"]}},\"required\":[\"engine\"],\"additionalProperties\":false,\"lindyMetadata\":{\"displayName\":\"YouTube\"}},{\"type\":\"object\",\"properties\":{\"engine\":{\"type\":\"string\",\"const\":\"google\"},\"location\":{\"type\":\"string\",\"description\":\"e.g San Francisco, CA\"}},\"required\":[\"engine\"],\"additionalProperties\":false,\"lindyMetadata\":{\"displayName\":\"Google\"}}],\"default\":{\"engine\":\"google\"},\"description\":\"Choose the engine most relevant to the query.\\nE.g. Whenever the user asks for news on a specific topic, use the news engine to search for the latest articles.\\nIf they are searching for products to buy, use the shopping engine. If you're not sure, use google.\",\"lindyMetadata\":{\"displayName\":\"Search engine\",\"userDescription\"