            "text": "{\"data\":{\"wizardSubTask\":null,\"node\":{\"__typename\":\"AgentDefinition\",\"id\":\"695d7c0b17d213e56045761c\",\"name\":\"Brand Monitor\",\"isMuted\":false,\"isAgentBuilder\":false,\"isManagedAgent\":false,\"currentDraftStateGraphId\":\"69702f2abefc694514b943d4\",\"createdAt\":\"2026-01-06T21:18:03.521Z\",\"description\":\"Tracks and monitors your brand's online presence.\",\"instructions\":\"\",\"stepByStepOnboardingStatus\":\"Skipped\",\"migratedToTasksV2\":true,\"greetingMessage\":\"Tell me what to do\",\"managedAgentInfo\":null,\"enabled\":true,\"nodeId\":\"QWdlbnREZWZpbml0aW9uOjY5NWQ3YzBiMTdkMjEzZTU2MDQ1NzYxYw==\",\"lastRunAt\":\"2026-01-08T19:48:22.278Z\",\"summary\":\"Track your brand's digital footprint\",\"model\":\"md\",\"shouldAskForConfirmation\":false,\"memories\":[],\"icon\":{\"color\":\"Pink\",\"name\":\"SunLightModeDayIcon\"},\"sharing\":{\"visibility\":\"private\"},\"tags\":[],\"flags\":{\"shouldHideFlowEditor\":false,\"isSpeechToTextModalMode\":false,\"defaultSpeechToTextModel\":\"SingleLanguage\"},\"permission\":\"owner\",\"isFavorite\":false,\"ownerInfo\":{\"__typename\":\"Identity\",\"__isNode\":\"Identity\",\"__isOwnerInfo\":\"Identity\",\"id\":\"693b2e83e6a088955f32f826\",\"name\":\"Michael Feiertag\",\"email\":\"m@mftestco.com\",\"nodeId\":\"SWRlbnRpdHk6NjkzYjJlODNlNmEwODg5NTVmMzJmODI2\"},\"hasEditors\":false,\"hasUsers\":false,\"latestWizardSubTask\":null,\"url\":\"https://chat.lindy.ai/michael-feiertags-workspace-2/lindy/brand-monitor-695d7c0b17d213e56045761c/tasks\",\"groupPermissions\":[],\"effectiveUserPermissions\":[],\"effectiveWorkspacePermission\":{\"access\":null,\"sources\":[],\"folderAccess\":null},\"stateGraphOverrides\":null,\"lock\":null,\"users\":{\"edges\":[]},\"notificationsCount\":4,\"parentFolder\":null,\"isCustomizable\":false,\"evaluations\":{\"totalCount\":0},\"canReceiveUserChannelMessages\":false,\"onboardingSubTask\":{\"id\":\"695d7c0b17d213e560457666\",\"nodeId\":\"U3ViVGFzazo2OTVkN2MwYjE3ZD