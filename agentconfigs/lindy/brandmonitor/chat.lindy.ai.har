{\"type\":\"object\",\"properties\":{\"type\":{\"type\":\"string\",\"const\":\"dynamic-projection\"}},\"required\":[\"type\"],\"additionalProperties\":false}]}]}},{\"type\":\"null\"}]}},\"required\":[\"tool\",\"toolDisplayName\",\"actionKey\",\"displayName\",\"description\",\"outputProperties\"],\"additionalProperties\":false},{\"type\":\"null\"}]},\"authDetails\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"provider\":{\"type\":\"string\"},\"scopes\":{\"anyOf\":[{\"type\":\"array\",\"items\":{\"type\":\"string\"}},{\"type\":\"null\"}]},\"availableAuths\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"authId\":{\"type\":\"string\"},\"label\":{\"type\":\"string\"},\"isMissingScopes\":{\"type\":\"boolean\"},\"isConnected\":{\"type\":\"boolean\"}},\"required\":[\"authId\",\"label\",\"isMissingScopes\",\"isConnected\"],\"additionalProperties\":false}}},\"required\":[\"provider\",\"availableAuths\"],\"additionalProperties\":false},{\"type\":\"null\"}]},\"reason\":{\"type\":[\"string\",\"null\"]}},\"required\":[\"type\",\"tool\",\"key\",\"details\",\"reason\"],\"additionalProperties\":false}]}}}],\"inputTree\":null}},\"knowledgeSources\":[]},{\"__typename\":\"ActionNode\",\"__isNode\":\"ActionNode\",\"id\":\"69375c149798419f67ff0d61\",\"type\":\"Action\",\"displayName\":null,\"layer\":[\"__BASE_LAYER__\"],\"guidelines\":null,\"manuallyPositioned\":false,\"model\":\"lg\",\"occurrence\":3,\"statefulToolOccurrence\":null,\"requireConfirmation\":\"Never\",\"specialProperties\":null,\"nodeId\":\"QWN0aW9uTm9kZTo2OTM3NWI1MjllNGM2NDhhZTU1ZTU4NmI6NjkzNzVjMTQ5Nzk4NDE5ZjY3ZmYwZDYx\",\"auth\":null,\"position\":{\"x\":448,\"y\":2840},\"actionConfiguration\":[{\"type\":\"ai\",\"allowAdditionalArrayEntries\":false,\"path\":[\"graphPatches\"],\"prompt\":[\"Build Trigger -> Agent Step with Tools + a Sticky Note (-400px) \"],\"unionType\":null,\"manualResult\":{\"isUndefined\":true,\"isNull\":false,\"value\":null}}],\"actionDefinition\":{\"createdByNodeId\":\"69375c149798419f67ff0d72\",\"statefulToolKey\":\"agentBuilder\",\"tool\":{\"description\":\"Let Lindy help you build your Agent\",\"displayName\":\"Agent builder\",\"isPopular\":false,\"tool\":\"LindyAgentBuilder\",\"nodeId\":\"VG9vbDpMaW5keUFnZW50QnVpbGRlcg==\"},\"action\":{\"authConfig\":null,\"dynamicLoaders\":null,\"key\":\"updateAgentGraph\",\"tool\":\"LindyAgentBuilder\",\"toolDisplayName\":\"Agent builder\",\"imageUrl\":null,\"description\":\"Use this to update the Agent Builder with new settings and behavior.\",\"displayName\":\"Updating agent graph\",\"outputSchema\":{},\"deprecated\":false,\"observableChannel\":null,\"hasSideEffects\":true,\"isPremium\":false,\"premiumActionCost\":null,\"showActionGuidelines\":false,\"nodeId\":\"QWN0aW9uRGV0YWlsczpMaW5keUFnZW50QnVpbGRlci51cGRhdGVBZ2VudEdyYXBoLjY4NDIxY2I3YzIyZDc0MDJlODFmNWZjOS42OTM3NWMxNDk3OTg0MTlmNjdmZjBkNzI=\",\"dependencies\":[],\"inputSchema\":{\"type\":\"object\",\"required\":[\"graphPatches\"],\"properties\":{\"graphPatches\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"required\":[\"patch\"],\"additionalProperties\":false,\"properties\":{\"description\":{\"type\":[\"string\",\"null\"],\"description\":\"A markdown-formatted string containing a customer-facing description of the change being made on this patch to the Agent, describing this step of the Flow to the user in non technical terms.\\nThe entry may start with \\\"[{ToolName}]\\\" where ToolName is the exact name of the tool related to this change (this will be used to display an icon in the UI).\\nNon-exhaustive example (one per line):\\n[Calendar] Added Calendar Event Started trigger\\n[Condition] Created condition: 'Event with a link?'\\n[LindyMeeting] Added Record Meeting action\\nConnected the Calendar Event Started trigger to the Record Meeting action\\n\\nThe [{ToolName}] prefix is not required, only use it when you know the Tool name. You can omit it if you don't know the Tool name, or are just providing extra details to the user about this step.\\nThis description field is optional, if the patch cannot be described in a single sentence to the user, you can omit it.\"},\"patch\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"op\":{\"type\":\"string\",\"const\":\"add\"},\"path\":{\"type\":\"string\"},\"value\":{}},\"required\":[\"op\",\"path\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"op\":{\"type\":\"string\",\"const\":\"replace\"},\"path\":{\"type\":\"string\"},\"value\":{}},\"required\":[\"op\",\"path\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"op\":{\"type\":\"string\",\"const\":\"test\"},\"path\":{\"type\":\"string\"},\"value\":{}},\"required\":[\"op\",\"path\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"op\":{\"type\":\"string\",\"const\":\"move\"},\"path\":{\"type\":\"string\"},\"from\":{\"type\":\"string\"},\"value\":{}},\"required\":[\"op\",\"path\",\"from\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"op\":{\"type\":\"string\",\"const\":\"copy\"},\"path\":{\"type\":\"string\"},\"from\":{\"type\":\"string\"},\"value\":{}},\"required\":[\"op\",\"path\",\"from\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"op\":{\"type\":\"string\",\"const\":\"remove\"},\"path\":{\"type\":\"string\"},\"value\":{}},\"required\":[\"op\",\"path\"],\"additionalProperties\":false}]}}}}},\"additionalProperties\":false},\"outputProperties\":[{\"displayName\":\"output\",\"type\":\"Unknown\",\"value\":\"#\",\"schema\":{}}],\"inputTree\":null}},\"knowledgeSources\":[]},{\"__typename\":\"ActionNode\",\"__isNode\":\"ActionNode\",\"id\":\"69375c149798419f67ff0d64\",\"type\":\"Action\",\"displayName\":null,\"layer\":[\"__BASE_LAYER__\"],\"guidelines\":null,\"manuallyPositioned\":false,\"model\":null,\"occurrence\":7,\"statefulToolOccurrence\":null,\"requireConfirmation\":\"Never\",\"specialProperties\":null,\"nodeId\":\"QWN0aW9uTm9kZTo2OTM3NWI1MjllNGM2NDhhZTU1ZTU4NmI6NjkzN