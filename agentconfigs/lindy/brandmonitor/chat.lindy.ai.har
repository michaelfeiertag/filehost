            "mimeType": "application/json",
            "text": "{\"query\":\"query AppInitializersQuery(\\n  $workspaceUrl: String!\\n) {\\n  me {\\n    ...useAnalytics_Identity\\n    ...useAdminAuthenticationChange_Identity\\n    ...useTimezone_Identity\\n    ...useInitOpenMainWindowHotkey_Identity_2hyKer\\n    ...DebugModePanel_Identity\\n    nodeId\\n  }\\n}\\n\\nfragment DebugModePanel_Identity on Identity {\\n  isAdmin\\n}\\n\\nfragment useAdminAuthenticationChange_Identity on Identity {\\n  id\\n  isLoggedInAsUser\\n}\\n\\nfragment useAnalytics_Identity on Identity {\\n  id\\n  email\\n  name\\n  phone\\n  analytics\\n}\\n\\nfragment useInitOpenMainWindowHotkey_Identity_2hyKer on Identity {\\n  workspaceMembershipFor(input: {url: $workspaceUrl}) {\\n    membershipSettings {\\n      openMainWindowHotkey\\n    }\\n    nodeId\\n  }\\n}\\n\\nfragment useTimezone_Identity on Identity {\\n  id\\n  nodeId\\n  timeZone\\n  isLoggedInAsUser\\n}\\n\",\"variables\":{\"workspaceUrl\":\"michael-feiertags-workspace-2\"}}",
